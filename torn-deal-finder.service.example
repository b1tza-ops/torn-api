[Unit]
Description=Torn Deal Finder Pro
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_LINUX_USER
WorkingDirectory=/home/REPLACE_WITH_LINUX_USER/torn-deal-finder
EnvironmentFile=/home/REPLACE_WITH_LINUX_USER/.torn-env
ExecStart=/home/REPLACE_WITH_LINUX_USER/torn-deal-finder/venv/bin/python /home/REPLACE_WITH_LINUX_USER/torn-deal-finder/app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
